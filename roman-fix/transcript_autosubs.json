{
 "segments": [
  {
   "start": 0.0,
   "end": 13.51,
   "text": "1928 में भगत सिंह के साथ मिलकर एचआरए को हिंदुस्तान सोशलिस्ट रिपब्लिकन एसोसिएशन एचएसआरए बनाने में अहम भूमिका निभाई। भगत सिंह और आजाद के नेतृत्व में एचएसआरए ने अंग्रेजों के होश उड़ा दिए थे। लेकिन सालों की लुका छुपी के इस खेल में आखिरकार"
  },
  {
   "start": 13.51,
   "end": 27.43,
   "text": "27 फरवरी 1931 को जब चंद्रशेखर आजाद अपने कॉमरेड से मिलने अल्फ्रेड पार्क गए हुए थे तभी ब्रिटिश पुलिस ने उन्हें चारों तरफ से घेर लिया। दोनों तरफ से फायरिंग होने लगी जिसमें चंद्रशेखर आजाद ने तीन पुलिस वालों"
  },
  {
   "start": 27.43,
   "end": 30.0,
   "text": "को मौत की नींद सुला दिया। लेकिन जब उनकी बंदूक में आखिरी गोली बची थी तो उन्होंने पुलिस के हाथ लगने से पहले ही अपनी बंदूक की आखिरी गोली अपने शरीर में उतार ली और अपने नाम की तरह आजाद रहकर ही शहीद हो गए।"
  }
 ],
